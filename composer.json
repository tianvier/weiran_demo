{
    "name": "poppy/project",
    "type": "project",
    "description": "The Poppy Project Starter",
    "keywords": [
        "framework",
        "laravel",
        "poppy"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-bcmath": "*",
        "laravel/framework": "6.*",
        "intervention/image": "2.*",
        "laravelcollective/html": "6.*",
        "predis/predis": "~1.1",
        "poppy/framework": "4.2.*",
        "poppy/system": "4.2.*",
        "poppy/core": "4.2.*",
        "poppy/mgr-page": "4.2.*"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "itsgoingd/clockwork": "~5.0",
        "barryvdh/laravel-ide-helper": "~2.6",
        "poppy/faker": "4.2.*",
        "doctrine/dbal": "^2.6"
    },
    "autoload": {
        "classmap": [
        ]
    },
    "autoload-dev": {
        "classmap": [
        ],
        "psr-4": {
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packeton.sour-lemon.com"
        }
    ],
    "scripts": {
        "poppy-init": [
            "php artisan poppy:migrate",
            "php artisan py-system:install",
            "php artisan py-system:user create_user"
        ],
        "poppy-update": [
            "./vendor/bin/poppy",
            "php artisan poppy:optimize",
            "php artisan vendor:publish --force --tag=poppy-mix",
            "php artisan py-core:permission init"
        ],
        "post-install-cmd": [
            "php artisan ide-helper:generate"
        ],
        "post-update-cmd": [
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan jwt:secret --force",
            "@php artisan vendor:publish --force --tag=poppy-mix"
        ]
    },
    "config": {
        "preferred-install": "dist"
    }
}
