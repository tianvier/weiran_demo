# app 环境
# local/test/development/pre/production 用来区分相应的环境
# ------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

# Database Config
# ------------------------------------
DB_HOST=127.0.0.1
DB_DATABASE=null
DB_USERNAME=null
DB_PASSWORD=null

# Framework Config
# ------------------------------------
CACHE_DRIVER=redis
CACHE_PREFIX=weiran_v1
SESSION_DRIVER=redis
QUEUE_DRIVER=sync

# Weiran Config
# ------------------------------------
WEIRAN_SECRET=null
WEIRAN_WEIRAN_CAPTCHA_LOGIN=false

# Third Party Config
# ------------------------------------
JWT_SECRET=
